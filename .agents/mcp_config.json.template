{
  "mcpServers": {
    "zotero": {
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "zotero_mcp.cli", "serve"],
      "env": {
        "ZOTERO_LOCAL": "{{ZOTERO_LOCAL}}",
        "ZOTERO_LIBRARY_ID": "{{ZOTERO_LIBRARY_ID}}",
        "ZOTERO_API_KEY": "{{ZOTERO_API_KEY}}"
      }
    }
  }
}